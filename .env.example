DATABASE_URL="postgresql://estoque:estoque@localhost:5432/estoque?schema=public"
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="estoque_session"
SESSION_TTL_DAYS="7"
PLATFORM_SESSION_COOKIE_NAME="vertice_platform_session"
PLATFORM_SESSION_TTL_DAYS="7"

# SMTP e opcional. Sem essas variaveis, os e-mails ficam em email_outbox como PENDING.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Vertice <no-reply@seudominio.com>"
SMTP_DELIVERY_TIMEOUT_MS="10000"

# O seed so cria o administrador quando as tres variaveis sao preenchidas.
SEED_COMPANY_NAME="Empresa Demonstracao"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@exemplo.com"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# O seed da plataforma cria um operador separado dos usuarios empresariais.
SEED_PLATFORM_NAME="Operador Vertice"
SEED_PLATFORM_EMAIL="platform@exemplo.com"
SEED_PLATFORM_PASSWORD="troque-esta-senha"
SEED_PLATFORM_ROLE="OWNER"
