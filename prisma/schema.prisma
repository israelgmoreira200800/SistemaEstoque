generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum PlatformUserStatus {
  ACTIVE
  BLOCKED
}

enum PlatformRole {
  OWNER
  ADMIN
  OPERATOR
  SUPPORT
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum PermissionOverrideEffect {
  GRANT
  DENY
}

enum ItemType {
  RAW_MATERIAL
  PACKAGING
  COMPONENT
  INTERMEDIATE
  FINISHED_PRODUCT
  RESALE
  INTERNAL_CONSUMPTION
}

enum StockMovementType {
  ENTRY
  EXIT
  LOSS
  ADJUSTMENT
  INVENTORY
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  ORDER_RESERVATION
  SHIPMENT
}

enum StockAdjustmentKind {
  ADJUSTMENT
  INVENTORY
}

enum StockAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum ProductionStatus {
  COMPLETED
  CANCELED
}

enum CustomerOrderStatus {
  OPEN
  APPROVED
  IN_PRODUCTION
  READY
  SHIPPED
  CANCELED
}

model Company {
  id                      String                   @id @default(cuid())
  name                    String
  slug                    String                   @unique
  legalName               String?                  @map("legal_name")
  tradeName               String?                  @map("trade_name")
  document                String?
  email                   String?
  phone                   String?
  status                  CompanyStatus            @default(TRIAL)
  planId                  String?                  @map("plan_id")
  timezone                String                   @default("America/Sao_Paulo")
  trialStartedAt          DateTime?                @map("trial_started_at")
  trialEndsAt             DateTime?                @map("trial_ends_at")
  activatedAt             DateTime?                @map("activated_at")
  suspendedAt             DateTime?                @map("suspended_at")
  cancelledAt             DateTime?                @map("cancelled_at")
  suspensionReason        String?                  @map("suspension_reason")
  cancellationReason      String?                  @map("cancellation_reason")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  plan                    Plan?                    @relation("CompanyCurrentPlan", fields: [planId], references: [id], onDelete: SetNull)
  users                   User[]
  roles                   Role[]
  sectors                 Sector[]
  auditLogs               AuditLog[]
  platformAuditLogs       PlatformAuditLog[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  userInvitations         UserInvitation[]
  emailOutbox             EmailOutbox[]
  units                   Unit[]
  categories              ItemCategory[]
  items                   Item[]
  unitConversions         ItemUnitConversion[]
  stockBalances           StockBalance[]
  stockMovements          StockMovement[]
  stockAdjustmentRequests StockAdjustmentRequest[]
  productComponents       ProductComponent[]
  productions             Production[]
  customerOrders          CustomerOrder[]
  subscriptions           Subscription[]
  usageLimits             UsageLimit[]
  billingEvents           BillingEvent[]

  @@index([status, createdAt])
  @@index([planId])
  @@index([document])
  @@map("companies")
}

model PlatformUser {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  passwordHash        String             @map("password_hash")
  status              PlatformUserStatus @default(ACTIVE)
  role                PlatformRole       @default(OPERATOR)
  failedLoginAttempts Int                @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?          @map("locked_until")
  lastLoginAt         DateTime?          @map("last_login_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  sessions            PlatformSession[]
  auditLogs           PlatformAuditLog[]

  @@index([status, name])
  @@map("platform_users")
}

model PlatformSession {
  id             String       @id @default(cuid())
  tokenHash      String       @unique @map("token_hash") @db.Char(64)
  platformUserId String       @map("platform_user_id")
  expiresAt      DateTime     @map("expires_at")
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at")
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  createdAt      DateTime     @default(now()) @map("created_at")
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, expiresAt])
  @@map("platform_sessions")
}

model PlatformAuditLog {
  id             String        @id @default(cuid())
  platformUserId String?       @map("platform_user_id")
  companyId      String?       @map("company_id")
  action         String
  entityType     String?       @map("entity_type")
  entityId       String?       @map("entity_id")
  requestId      String?       @map("request_id")
  ipAddress      String?       @map("ip_address")
  reason         String?
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  platformUser   PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([platformUserId, createdAt])
  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@map("platform_audit_logs")
}

model Plan {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  description       String?
  status            CatalogStatus  @default(ACTIVE)
  monthlyPriceCents Int?           @map("monthly_price_cents")
  currency          String         @default("BRL")
  trialDays         Int?           @map("trial_days")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  companies         Company[]      @relation("CompanyCurrentPlan")
  features          PlanFeature[]
  subscriptions     Subscription[]

  @@index([status, name])
  @@map("plans")
}

model PlanFeature {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  key       String
  name      String
  value     Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("plan_features")
}

model Subscription {
  id                     String             @id @default(cuid())
  companyId              String             @map("company_id")
  planId                 String             @map("plan_id")
  status                 SubscriptionStatus @default(TRIALING)
  startedAt              DateTime           @default(now()) @map("started_at")
  trialStartedAt         DateTime?          @map("trial_started_at")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  currentPeriodStartedAt DateTime?          @map("current_period_started_at")
  currentPeriodEndsAt    DateTime?          @map("current_period_ends_at")
  cancelledAt            DateTime?          @map("cancelled_at")
  metadata               Json?
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  usageLimits            UsageLimit[]
  billingEvents          BillingEvent[]

  @@index([companyId, status])
  @@index([planId, status])
  @@map("subscriptions")
}

model UsageLimit {
  id             String        @id @default(cuid())
  companyId      String        @map("company_id")
  subscriptionId String?       @map("subscription_id")
  key            String
  limitValue     Int?          @map("limit_value")
  usedValue      Int           @default(0) @map("used_value")
  unit           String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([companyId, key])
  @@index([subscriptionId])
  @@map("usage_limits")
}

model BillingEvent {
  id             String        @id @default(cuid())
  companyId      String        @map("company_id")
  subscriptionId String?       @map("subscription_id")
  type           String
  occurredAt     DateTime      @default(now()) @map("occurred_at")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([companyId, occurredAt])
  @@index([subscriptionId])
  @@map("billing_events")
}

model User {
  id                        String                   @id @default(cuid())
  companyId                 String                   @map("company_id")
  name                      String
  email                     String                   @unique
  passwordHash              String                   @map("password_hash")
  status                    UserStatus               @default(ACTIVE)
  failedLoginAttempts       Int                      @default(0) @map("failed_login_attempts")
  lockedUntil               DateTime?                @map("locked_until")
  lastLoginAt               DateTime?                @map("last_login_at")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  company                   Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  roles                     UserRole[]
  permissionOverrides       UserPermissionOverride[] @relation("UserPermissionOverrides")
  createdOverrides          UserPermissionOverride[] @relation("PermissionOverrideCreator")
  sectors                   UserSector[]
  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]
  invitations               UserInvitation[]         @relation("InvitedUser")
  createdInvitations        UserInvitation[]         @relation("InvitationCreator")
  emailMessages             EmailOutbox[]
  auditLogs                 AuditLog[]
  stockMovements            StockMovement[]
  requestedStockAdjustments StockAdjustmentRequest[] @relation("StockAdjustmentRequester")
  reviewedStockAdjustments  StockAdjustmentRequest[] @relation("StockAdjustmentReviewer")
  productions               Production[]
  customerOrders            CustomerOrder[]

  @@index([companyId, status, name])
  @@unique([companyId, id])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  companyId   String           @map("company_id")
  name        String
  slug        String
  description String?
  status      CatalogStatus    @default(ACTIVE)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, slug])
  @@unique([companyId, id])
  @@index([companyId, status, name])
  @@map("roles")
}

model Permission {
  id            String                   @id @default(cuid())
  key           String                   @unique
  module        String
  action        String
  name          String
  description   String?
  roles         RolePermission[]
  userOverrides UserPermissionOverride[]

  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id              String                   @id @default(cuid())
  userId          String                   @map("user_id")
  permissionId    String                   @map("permission_id")
  effect          PermissionOverrideEffect
  reason          String?
  createdByUserId String?                  @map("created_by_user_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  user            User                     @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission      Permission               @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdBy       User?                    @relation("PermissionOverrideCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([permissionId, effect])
  @@map("user_permission_overrides")
}

model Sector {
  id          String        @id @default(cuid())
  companyId   String        @map("company_id")
  name        String
  description String?
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       UserSector[]

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@index([companyId, status, name])
  @@map("sectors")
}

model UserSector {
  userId    String   @map("user_id")
  sectorId  String   @map("sector_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector    Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([userId, sectorId])
  @@index([sectorId])
  @@map("user_sectors")
}

model Unit {
  id                  String               @id @default(cuid())
  companyId           String               @map("company_id")
  name                String
  symbol              String
  allowsFraction      Boolean              @default(false) @map("allows_fraction")
  status              CatalogStatus        @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items               Item[]
  conversionsAsSource ItemUnitConversion[]

  @@unique([companyId, symbol])
  @@unique([companyId, id])
  @@index([companyId, status, name])
  @@map("units")
}

model ItemCategory {
  id        String        @id @default(cuid())
  companyId String        @map("company_id")
  name      String
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items     Item[]

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@index([companyId, status, name])
  @@map("item_categories")
}

model Item {
  id                      String                   @id @default(cuid())
  companyId               String                   @map("company_id")
  unitId                  String                   @map("unit_id")
  categoryId              String?                  @map("category_id")
  name                    String
  type                    ItemType
  sku                     String?
  barcode                 String?
  minimumStock            Decimal                  @default(0) @map("minimum_stock") @db.Decimal(18, 6)
  cost                    Decimal                  @default(0) @db.Decimal(18, 6)
  salePrice               Decimal                  @default(0) @map("sale_price") @db.Decimal(18, 6)
  description             String?
  status                  CatalogStatus            @default(ACTIVE)
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  unit                    Unit                     @relation(fields: [companyId, unitId], references: [companyId, id], onDelete: Restrict)
  category                ItemCategory?            @relation(fields: [companyId, categoryId], references: [companyId, id], onDelete: Restrict)
  unitConversions         ItemUnitConversion[]
  stockBalance            StockBalance?
  stockMovements          StockMovement[]
  stockAdjustmentRequests StockAdjustmentRequest[]
  productRecipe           ProductComponent[]       @relation("ProductRecipe")
  usedAsComponent         ProductComponent[]       @relation("ComponentUsage")
  productionOutputs       Production[]
  orderItems              CustomerOrderItem[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@unique([companyId, id])
  @@index([companyId, status, name])
  @@index([companyId, type])
  @@map("items")
}

model ItemUnitConversion {
  id                String        @id @default(cuid())
  companyId         String        @map("company_id")
  itemId            String        @map("item_id")
  sourceUnitId      String        @map("source_unit_id")
  factorToStockUnit Decimal       @map("factor_to_stock_unit") @db.Decimal(18, 6)
  status            CatalogStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item              Item          @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  sourceUnit        Unit          @relation(fields: [companyId, sourceUnitId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, itemId, sourceUnitId])
  @@index([companyId, status])
  @@map("item_unit_conversions")
}

model StockBalance {
  id               String   @id @default(cuid())
  companyId        String   @map("company_id")
  itemId           String   @unique @map("item_id")
  quantityOnHand   Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(18, 6)
  quantityReserved Decimal  @default(0) @map("quantity_reserved") @db.Decimal(18, 6)
  quantityBlocked  Decimal  @default(0) @map("quantity_blocked") @db.Decimal(18, 6)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item             Item     @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, itemId])
  @@index([companyId, quantityOnHand])
  @@map("stock_balances")
}

model StockMovement {
  id                String                  @id @default(cuid())
  companyId         String                  @map("company_id")
  itemId            String                  @map("item_id")
  type              StockMovementType
  quantity          Decimal                 @db.Decimal(18, 6)
  balanceAfter      Decimal                 @default(0) @map("balance_after") @db.Decimal(18, 6)
  documentNumber    String?                 @map("document_number")
  note              String?
  sourceType        String?                 @map("source_type")
  sourceId          String?                 @map("source_id")
  createdByUserId   String?                 @map("created_by_user_id")
  metadata          Json?
  createdAt         DateTime                @default(now()) @map("created_at")
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item              Item                    @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  createdBy         User?                   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  adjustmentRequest StockAdjustmentRequest?

  @@index([companyId, createdAt])
  @@index([companyId, itemId, createdAt])
  @@index([companyId, sourceType, sourceId])
  @@unique([companyId, id])
  @@map("stock_movements")
}

model StockAdjustmentRequest {
  id                String                @id @default(cuid())
  companyId         String                @map("company_id")
  itemId            String                @map("item_id")
  kind              StockAdjustmentKind
  status            StockAdjustmentStatus @default(PENDING)
  currentQuantity   Decimal               @map("current_quantity") @db.Decimal(18, 6)
  requestedQuantity Decimal               @map("requested_quantity") @db.Decimal(18, 6)
  appliedDelta      Decimal?              @map("applied_delta") @db.Decimal(18, 6)
  documentNumber    String?               @map("document_number")
  reason            String?
  reviewNote        String?               @map("review_note")
  requestedByUserId String?               @map("requested_by_user_id")
  reviewedByUserId  String?               @map("reviewed_by_user_id")
  reviewedAt        DateTime?             @map("reviewed_at")
  movementId        String?               @unique @map("movement_id")
  metadata          Json?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item              Item                  @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  requestedBy       User?                 @relation("StockAdjustmentRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedBy        User?                 @relation("StockAdjustmentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  movement          StockMovement?        @relation(fields: [movementId], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([companyId, itemId, status])
  @@index([requestedByUserId, createdAt])
  @@index([reviewedByUserId, reviewedAt])
  @@map("stock_adjustment_requests")
}

model ProductComponent {
  id              String        @id @default(cuid())
  companyId       String        @map("company_id")
  productId       String        @map("product_id")
  componentItemId String        @map("component_item_id")
  quantity        Decimal       @db.Decimal(18, 6)
  status          CatalogStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product         Item          @relation("ProductRecipe", fields: [companyId, productId], references: [companyId, id], onDelete: Restrict)
  componentItem   Item          @relation("ComponentUsage", fields: [companyId, componentItemId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, productId, componentItemId])
  @@index([companyId, productId, status])
  @@index([companyId, componentItemId])
  @@map("product_components")
}

model Production {
  id              String           @id @default(cuid())
  companyId       String           @map("company_id")
  productId       String           @map("product_id")
  quantity        Decimal          @db.Decimal(18, 6)
  status          ProductionStatus @default(COMPLETED)
  createdByUserId String?          @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product         Item             @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict)
  createdBy       User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, productId])
  @@map("productions")
}

model CustomerOrder {
  id              String              @id @default(cuid())
  companyId       String              @map("company_id")
  customerName    String?             @map("customer_name")
  documentNumber  String?             @map("document_number")
  status          CustomerOrderStatus @default(OPEN)
  createdByUserId String?             @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           CustomerOrderItem[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@unique([companyId, id])
  @@map("customer_orders")
}

model CustomerOrderItem {
  id        String        @id @default(cuid())
  companyId String        @map("company_id")
  orderId   String        @map("order_id")
  itemId    String        @map("item_id")
  quantity  Decimal       @db.Decimal(18, 6)
  createdAt DateTime      @default(now()) @map("created_at")
  order     CustomerOrder @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade)
  item      Item          @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, orderId])
  @@index([companyId, itemId])
  @@map("customer_order_items")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  companyId String    @map("company_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model UserInvitation {
  id              String    @id @default(cuid())
  companyId       String    @map("company_id")
  userId          String    @map("user_id")
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  usedAt          DateTime? @map("used_at")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User      @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, userId, expiresAt])
  @@index([createdByUserId, createdAt])
  @@index([expiresAt])
  @@map("user_invitations")
}

model EmailOutbox {
  id             String    @id @default(cuid())
  companyId      String?   @map("company_id")
  userId         String?   @map("user_id")
  recipientEmail String    @map("recipient_email")
  subject        String
  body           String
  purpose        String
  status         String    @default("PENDING")
  metadata       Json?
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@index([purpose, createdAt])
  @@map("email_outbox")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  userId     String   @map("user_id")
  companyId  String   @map("company_id")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([companyId, expiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?  @map("company_id")
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  requestId  String?  @map("request_id")
  ipAddress  String?  @map("ip_address")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
