generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum PermissionOverrideEffect {
  GRANT
  DENY
}

enum ItemType {
  RAW_MATERIAL
  PACKAGING
  COMPONENT
  INTERMEDIATE
  FINISHED_PRODUCT
  RESALE
  INTERNAL_CONSUMPTION
}

enum StockMovementType {
  ENTRY
  EXIT
  LOSS
  ADJUSTMENT
  INVENTORY
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  ORDER_RESERVATION
  SHIPMENT
}

enum ProductionStatus {
  COMPLETED
  CANCELED
}

enum CustomerOrderStatus {
  OPEN
  APPROVED
  IN_PRODUCTION
  READY
  SHIPPED
  CANCELED
}

model Company {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  status            CompanyStatus      @default(ACTIVE)
  timezone          String             @default("America/Sao_Paulo")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  users             User[]
  roles             Role[]
  sectors           Sector[]
  auditLogs         AuditLog[]
  sessions          Session[]
  units             Unit[]
  categories        ItemCategory[]
  items             Item[]
  unitConversions   ItemUnitConversion[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  productComponents ProductComponent[]
  productions       Production[]
  customerOrders    CustomerOrder[]

  @@map("companies")
}

model User {
  id                  String                   @id @default(cuid())
  companyId           String                   @map("company_id")
  name                String
  email               String                   @unique
  passwordHash        String                   @map("password_hash")
  status              UserStatus               @default(ACTIVE)
  failedLoginAttempts Int                      @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?                @map("locked_until")
  lastLoginAt         DateTime?                @map("last_login_at")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  roles               UserRole[]
  permissionOverrides UserPermissionOverride[] @relation("UserPermissionOverrides")
  createdOverrides    UserPermissionOverride[] @relation("PermissionOverrideCreator")
  sectors             UserSector[]
  sessions            Session[]
  auditLogs           AuditLog[]
  stockMovements      StockMovement[]
  productions         Production[]
  customerOrders      CustomerOrder[]

  @@index([companyId, status, name])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  companyId   String           @map("company_id")
  name        String
  slug        String
  description String?
  status      CatalogStatus    @default(ACTIVE)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, slug])
  @@index([companyId, status, name])
  @@map("roles")
}

model Permission {
  id            String                   @id @default(cuid())
  key           String                   @unique
  module        String
  action        String
  name          String
  description   String?
  roles         RolePermission[]
  userOverrides UserPermissionOverride[]

  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id              String                   @id @default(cuid())
  userId          String                   @map("user_id")
  permissionId    String                   @map("permission_id")
  effect          PermissionOverrideEffect
  reason          String?
  createdByUserId String?                  @map("created_by_user_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  user            User                     @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission      Permission               @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdBy       User?                    @relation("PermissionOverrideCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([permissionId, effect])
  @@map("user_permission_overrides")
}

model Sector {
  id          String        @id @default(cuid())
  companyId   String        @map("company_id")
  name        String
  description String?
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       UserSector[]

  @@unique([companyId, name])
  @@index([companyId, status, name])
  @@map("sectors")
}

model UserSector {
  userId    String   @map("user_id")
  sectorId  String   @map("sector_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector    Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([userId, sectorId])
  @@index([sectorId])
  @@map("user_sectors")
}

model Unit {
  id             String               @id @default(cuid())
  companyId      String               @map("company_id")
  name           String
  symbol         String
  allowsFraction Boolean              @default(false) @map("allows_fraction")
  status         CatalogStatus        @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items          Item[]
  conversionsAsSource ItemUnitConversion[]

  @@unique([companyId, symbol])
  @@index([companyId, status, name])
  @@map("units")
}

model ItemCategory {
  id        String        @id @default(cuid())
  companyId String        @map("company_id")
  name      String
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items     Item[]

  @@unique([companyId, name])
  @@index([companyId, status, name])
  @@map("item_categories")
}

model Item {
  id              String             @id @default(cuid())
  companyId       String             @map("company_id")
  unitId          String             @map("unit_id")
  categoryId      String?            @map("category_id")
  name            String
  type            ItemType
  sku             String?
  barcode         String?
  minimumStock    Decimal            @default(0) @map("minimum_stock") @db.Decimal(18, 6)
  cost            Decimal            @default(0) @db.Decimal(18, 6)
  salePrice       Decimal            @default(0) @map("sale_price") @db.Decimal(18, 6)
  description     String?
  status          CatalogStatus      @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  unit            Unit               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  category        ItemCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitConversions ItemUnitConversion[]
  stockBalance    StockBalance?
  stockMovements  StockMovement[]
  productRecipe   ProductComponent[] @relation("ProductRecipe")
  usedAsComponent ProductComponent[] @relation("ComponentUsage")
  productionOutputs Production[]
  orderItems      CustomerOrderItem[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, status, name])
  @@index([companyId, type])
  @@map("items")
}

model ItemUnitConversion {
  id                String        @id @default(cuid())
  companyId         String        @map("company_id")
  itemId            String        @map("item_id")
  sourceUnitId      String        @map("source_unit_id")
  factorToStockUnit Decimal       @map("factor_to_stock_unit") @db.Decimal(18, 6)
  status            CatalogStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item              Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sourceUnit        Unit          @relation(fields: [sourceUnitId], references: [id], onDelete: Restrict)

  @@unique([companyId, itemId, sourceUnitId])
  @@index([companyId, status])
  @@map("item_unit_conversions")
}

model StockBalance {
  id               String   @id @default(cuid())
  companyId        String   @map("company_id")
  itemId           String   @unique @map("item_id")
  quantityOnHand   Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(18, 6)
  quantityReserved Decimal  @default(0) @map("quantity_reserved") @db.Decimal(18, 6)
  quantityBlocked  Decimal  @default(0) @map("quantity_blocked") @db.Decimal(18, 6)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([companyId, itemId])
  @@index([companyId, quantityOnHand])
  @@map("stock_balances")
}

model StockMovement {
  id              String            @id @default(cuid())
  companyId       String            @map("company_id")
  itemId          String            @map("item_id")
  type            StockMovementType
  quantity        Decimal           @db.Decimal(18, 6)
  balanceAfter    Decimal           @default(0) @map("balance_after") @db.Decimal(18, 6)
  documentNumber  String?           @map("document_number")
  note            String?
  sourceType      String?           @map("source_type")
  sourceId        String?           @map("source_id")
  createdByUserId String?           @map("created_by_user_id")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item            Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  createdBy       User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, itemId, createdAt])
  @@index([companyId, sourceType, sourceId])
  @@map("stock_movements")
}

model ProductComponent {
  id              String        @id @default(cuid())
  companyId       String        @map("company_id")
  productId       String        @map("product_id")
  componentItemId String        @map("component_item_id")
  quantity        Decimal       @db.Decimal(18, 6)
  status          CatalogStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product         Item          @relation("ProductRecipe", fields: [productId], references: [id], onDelete: Restrict)
  componentItem   Item          @relation("ComponentUsage", fields: [componentItemId], references: [id], onDelete: Restrict)

  @@unique([companyId, productId, componentItemId])
  @@index([companyId, productId, status])
  @@index([companyId, componentItemId])
  @@map("product_components")
}

model Production {
  id              String           @id @default(cuid())
  companyId       String           @map("company_id")
  productId       String           @map("product_id")
  quantity        Decimal          @db.Decimal(18, 6)
  status          ProductionStatus @default(COMPLETED)
  createdByUserId String?          @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product         Item             @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy       User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, productId])
  @@map("productions")
}

model CustomerOrder {
  id              String              @id @default(cuid())
  companyId       String              @map("company_id")
  customerName    String?             @map("customer_name")
  documentNumber  String?             @map("document_number")
  status          CustomerOrderStatus @default(OPEN)
  createdByUserId String?             @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           CustomerOrderItem[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@map("customer_orders")
}

model CustomerOrderItem {
  id        String        @id @default(cuid())
  companyId String        @map("company_id")
  orderId   String        @map("order_id")
  itemId    String        @map("item_id")
  quantity  Decimal       @db.Decimal(18, 6)
  createdAt DateTime      @default(now()) @map("created_at")
  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item      Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([companyId, orderId])
  @@index([companyId, itemId])
  @@map("customer_order_items")
}

model Session {
  id          String   @id @default(cuid())
  tokenHash   String   @unique @map("token_hash") @db.Char(64)
  userId      String   @map("user_id")
  companyId   String   @map("company_id")
  expiresAt   DateTime @map("expires_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([companyId, expiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?  @map("company_id")
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  requestId  String?  @map("request_id")
  ipAddress  String?  @map("ip_address")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
